# Razorpay Live — Key ID is public; Secret must NEVER be committed or exposed to frontend.
# Copy this to .env and set RAZORPAY_KEY_SECRET (get it from Razorpay Dashboard → API Keys).
VITE_RAZORPAY_KEY_ID=rzp_live_SEo7lCnNbH00WM
RAZORPAY_KEY_ID=rzp_live_SEo7lCnNbH00WM
RAZORPAY_KEY_SECRET=your_secret_from_razorpay_dashboard

# Required for local dev: app URL so Vite can proxy /api to it (restart dev after changing)
VITE_API_BASE_URL=https://hmstours.in

# Unsplash API - Get your access key from https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# OpenWeather API - Get your API key from https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# Contact Information
VITE_CONTACT_PHONE=+91-8278717103
VITE_WHATSAPP_NUMBER=918805795706

# Group Booking Threshold
VITE_GROUP_BOOKING_MIN=8
